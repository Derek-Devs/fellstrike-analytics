# The Lightdash CLI, with dbt, in a container (docs/analytics-design.md, section 9.2). The CLI has no Windows build
# and needs Node 24, and running it here also puts it on the same Docker network as Lightdash and the warehouse.
# Built and run by docker compose (the lightdash-cli service). The versions match the Lightdash server and the
# analytics project's requirements.txt.
FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv git \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /venv \
    && /venv/bin/pip install --no-cache-dir dbt-core==1.12.7 dbt-postgres==1.11.0
ENV PATH="/venv/bin:${PATH}"

RUN npm install -g @lightdash/cli@3.366.0

WORKDIR /dbt
