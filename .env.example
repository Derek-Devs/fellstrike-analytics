# Copy this file to .env (git ignores .env) and change the password in both places.
# The warehouse listens only on this PC (127.0.0.1), on WAREHOUSE_PORT.
WAREHOUSE_DB=fellstrike
WAREHOUSE_USER=analytics
WAREHOUSE_PASSWORD=change-me
WAREHOUSE_PORT=5433
WAREHOUSE_URL=postgresql://analytics:change-me@127.0.0.1:5433/fellstrike

# Lightdash (docs/analytics-design.md, section 9). Change each of these. LIGHTDASH_SECRET encrypts what Lightdash
# stores, so keep it the same once Lightdash has started: losing it loses the saved warehouse login.
LIGHTDASH_SECRET=change-me
LIGHTDASH_DB_PASSWORD=change-me
LIGHTDASH_MINIO_PASSWORD=change-me
# Lightdash's read-only login to the warehouse (lightdash/reader.sql)
LIGHTDASH_WAREHOUSE_PASSWORD=change-me
# For the Lightdash CLI and the parity check: a personal access token made in Lightdash (Settings, Personal access
# tokens), and the project's UUID, which lightdash deploy --create prints.
LIGHTDASH_API_KEY=
LIGHTDASH_PROJECT=